# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Jangan tambahkan ?sslmode
DATABASE_URL=

# Minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key aman untuk publik dan di-inline saat build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key hanya dibaca server. Wajib diisi di production; tanpa secret,
# pembuatan tiket publik akan ditolak (503) agar form tidak berjalan tanpa CAPTCHA.
TURNSTILE_SECRET_KEY=
